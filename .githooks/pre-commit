#!/usr/bin/env bash
# Bloquea commits que incluyan archivos sensibles o secretos en el contenido.
# Activar con: git config core.hooksPath .githooks
# Saltar en un caso justificado (falso positivo): git commit --no-verify

set -euo pipefail

fail=0
red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# 1) Nombres de archivo prohibidos
forbidden_names='(^|/)(\.env(\..*)?|.*\.env|.*\.(pem|key|p12|pfx|jks|keystore|ppk|tfvars|tfstate|sqlite3?|db|dump)|id_(rsa|ed25519|ecdsa).*|credentials.*\.json|service-account.*\.json|.*-service-account\.json|\.npmrc|\.pypirc|\.netrc|\.htpasswd)$'

while IFS= read -r -d '' file; do
  if [[ "$file" =~ $forbidden_names && "$(basename "$file")" != ".env.example" ]]; then
    red "✗ Archivo sensible en el commit: $file"
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# 2) Patrones de secretos en las líneas añadidas
patterns=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'                                   # AWS access key
  'ASIA[0-9A-Z]{16}'                                   # AWS temp key
  'AIza[0-9A-Za-z_-]{35}'                              # Google API key
  'gh[pousr]_[0-9A-Za-z]{36,}'                         # GitHub token
  'github_pat_[0-9A-Za-z_]{40,}'
  'xox[baprs]-[0-9A-Za-z-]{10,}'                       # Slack token
  '(sk|rk)_live_[0-9A-Za-z]{16,}'                      # Stripe live key
  'whsec_[0-9A-Za-z]{20,}'                             # Stripe webhook
  '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'                        # OpenAI / Anthropic style
  'SG\.[0-9A-Za-z_-]{22}\.[0-9A-Za-z_-]{43}'           # SendGrid
  'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' # JWT
  '(postgres(ql)?|mysql|mongodb(\+srv)?|redis|amqp)://[^:/@[:space:]]+:[^@[:space:]]+@' # URL con contraseña
  '(password|passwd|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'
)

added=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/*' | grep -E '^\+[^+]' || true)

for p in "${patterns[@]}"; do
  if matches=$(printf '%s\n' "$added" | grep -inE -- "$p"); then
    red "✗ Posible secreto detectado (patrón: $p):"
    printf '%s\n' "$matches" | cut -c1-120 >&2
    fail=1
  fi
done

if (( fail )); then
  red ""
  red "Commit bloqueado. Mueve los secretos a .env (ignorado) y usa variables de entorno."
  red "Si es un falso positivo: git commit --no-verify"
  exit 1
fi
