# Plantilla de variables de entorno (Laravel).
# Copia este archivo a .env y rellena los valores reales. .env NUNCA se versiona.
# Aquí solo van NOMBRES de variables y valores de ejemplo, jamás secretos reales.

APP_NAME="Gaining Grades"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Base de datos: usuario de la app (solo SELECT/INSERT/UPDATE/DELETE), nunca root
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cursos_el_mai
DB_USERNAME=cursos_app
DB_PASSWORD=

# Clave de los 4 usuarios de prueba (solo local; el seeder se niega a correr en producción)
DEMO_PASSWORD=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Correo: "log" en desarrollo; SMTP real en producción
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Chat en vivo (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Videollamada (Jitsi JaaS) — pendiente del spike de la Fase 5
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=

# Portada pública: contacto (se muestran en la página)
SITE_CONTACT_EMAIL=contacto@ejemplo.com
SITE_WHATSAPP=520000000000

# Registro abierto (hito DEMO)
SITE_OPEN_REGISTRATION=false
