{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials*.json)",
      "Read(**/*service-account*.json)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/uploads/**)",
      "Read(**/backups/**)",
      "Read(**/dumps/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(.githooks/**)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git commit*--no-verify*)",
      "Bash(git push*--force*)",
      "Bash(git config core.hooksPath*)"
    ]
  }
}
